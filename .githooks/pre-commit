#!/usr/bin/env bash
# pre-commit: integrity gate for the standards package (canon - project_standards.md, 06.01)
# Checks:
#   1) editing doc/standards/*.md requires updating _index_standards.md in the same commit
#   2) single package version: headers of all doc/standards/*.md match each other
#      and the localized standard-version line in AGENTS.md, README.md, CLAUDE.md (if present)
#   3) mirror: CLAUDE.md = AGENTS.md except for known lines (H1 and intro),
#      unless doc/specs/overrides.md contains its own CLAUDE.md policy
#   4) references: contextual section references like "section NN.NN" and "(NN.NN" in staged
#      package files point to existing package sections; bare mentions out of context
#      are not checked (protection against false positives on examples in the text)
# Works for the hub and derived repos. Activation on a machine: git config core.hooksPath .githooks

set -euo pipefail

INDEX="doc/standards/_index_standards.md"
FAIL=0

staged_files() {
    git diff --cached --name-only --diff-filter=ACMR -- "$@"
}

staged_standards_md() {
    git diff --cached --name-only --diff-filter=ACMR -- 'doc/standards/*.md' | grep -E '^doc/standards/[^/]+\.md$' || true
}

all_standards_md() {
    git ls-files -- 'doc/standards/*.md' | grep -E '^doc/standards/[^/]+\.md$' || true
}

# file content from the commit index (staged; for untouched files = HEAD)
indexed() {
    git show ":$1" 2>/dev/null || true
}

# --- 1. Standards index freshness ---

CHANGED_STANDARDS=$(staged_standards_md | grep -v -F "$INDEX" || true)
if [ -n "$CHANGED_STANDARDS" ] && ! staged_files "$INDEX" | grep -q .; then
    echo "[!] Изменены файлы стандарта без обновления _index_standards.md" >&2
    echo "$CHANGED_STANDARDS" | sed 's/^/      - /' >&2
    echo "    [*] Выполните автоактуализацию $INDEX (раздел Автоактуализация индекса)" >&2
    echo "    и добавьте его в коммит" >&2
    FAIL=1
fi

# --- 2. Single package version (when standards are edited in the commit) ---

if staged_standards_md | grep -q .; then
    expected=""
    mismatch=""
    for f in $(all_standards_md); do
        [ -f "$f" ] || continue
        v=$(indexed "$f" | head -n 1 | grep -oE '(Version|Версия) [0-9]+\.[0-9]+\.[0-9]+' | awk '{print $2}' || true)
        [ -z "$v" ] && continue
        if [ -z "$expected" ]; then
            expected="$v"
        elif [ "$v" != "$expected" ]; then
            mismatch="$mismatch $f:$v"
        fi
    done
    IS_HUB=0
    if [ -f doc/skills/_index_skills_hub.md ]; then
        IS_HUB=1
    fi
    for f in AGENTS.md README.md CLAUDE.md; do
        [ -f "$f" ] || continue
        if [ "$IS_HUB" -eq 0 ] && ! git diff --cached --name-only | grep -qx "$f"; then
            continue
        fi
        v=$(indexed "$f" | grep -m1 -oE '(Standard version|Соответствует стандарту): [0-9]+\.[0-9]+\.[0-9]+' | awk -F': ' '{print $2}' || true)
        [ -z "$v" ] && continue
        if [ -z "$expected" ]; then
            expected="$v"
        elif [ "$v" != "$expected" ]; then
            mismatch="$mismatch $f:$v"
        fi
    done
    if [ -n "$mismatch" ]; then
        echo "[!] Версии пакета не синхронны (базовая: ${expected}):${mismatch}" >&2
        echo "    [*] Bump версии - одно значение во всех заголовках doc/standards/*.md" >&2
        echo "    и в строках «Соответствует стандарту» / «Standard version» AGENTS.md, README.md, CLAUDE.md" >&2
        FAIL=1
    fi
fi

# --- 3. Mirror CLAUDE.md = AGENTS.md ---

if [ -f AGENTS.md ] && [ -f CLAUDE.md ]; then
    if [ -f doc/specs/overrides.md ] && grep -q 'CLAUDE' doc/specs/overrides.md; then
        :  # own CLAUDE.md policy - mirror not required
    else
        normalize() {
            sed -e 's|^# AGENTS\.md$|# MIRROR|' \
                -e 's|^# CLAUDE\.md$|# MIRROR|' \
                -e 's|инструкции для AI-агентов при работе|инструкции для MIRROR при работе|' \
                -e 's|инструкции для Claude Code при работе|инструкции для MIRROR при работе|' \
                -e 's|instructions for AI agents|instructions for MIRROR|' \
                -e 's|instructions for Claude Code|instructions for MIRROR|' "$1"
        }
        if ! diff -q <(indexed AGENTS.md | normalize /dev/stdin) <(indexed CLAUDE.md | normalize /dev/stdin) >/dev/null; then
            echo "[!] CLAUDE.md расходится с AGENTS.md (зеркало)" >&2
            echo "    [*] Синхронизируйте зеркало; допустимые отличия - только H1 и строка интро" >&2
            FAIL=1
        fi
    fi
fi

# --- 4. Contextual NN.NN references in staged package files ---

sections=$(for f in $(all_standards_md); do
    [ -f "$f" ] || continue
    indexed "$f"
done | grep -oE '^#{1,4} [0-9]{2}\.[0-9]{2}(\.[0-9]{2})?' | grep -oE '[0-9]{2}\.[0-9]{2}(\.[0-9]{2})?' | sort -u || true)

if [ -n "$sections" ]; then
    for f in $(staged_standards_md); do
        [ -f "$f" ] || continue
        refs=$(indexed "$f" | grep -oE '[Рр]аздел[а-я]{0,3} [0-9]{2}\.[0-9]{2}(\.[0-9]{2})?|[Ss]ections? [0-9]{2}\.[0-9]{2}(\.[0-9]{2})?|\([0-9]{2}\.[0-9]{2}(\.[0-9]{2})?' | grep -oE '[0-9]{2}\.[0-9]{2}(\.[0-9]{2})?' | sort -u || true)
        for r in $refs; do
            if ! echo "$sections" | grep -qx "$r"; then
                echo "[!] Ссылка на несуществующий раздел: $f -> $r" >&2
                echo "    [*] Проверьте номер раздела или обновите ссылки при перенумерации" >&2
                FAIL=1
            fi
        done
    done
fi

exit "$FAIL"
